/**
 @defgroup FSM_machine Автомат (FSM)
 @brief Высокоуровневый API для работы с конечным автоматом.

 Группа объединяет всё, что относится к работе с экземпляром автомата
 как с целостным объектом: его тип, создание и уничтожение, настройку
 начального состояния, обработку событий и периодическое обновление.

 Через функции этой группы пользователь запускает, останавливает и
 управляет поведением FSM в прикладном коде.
*/

/**
 @defgroup FSM_machine_types Типы автомата
 @ingroup FSM_machine
 @brief Базовые типы, описывающие автомат и его идентификаторы.

Включает непрозрачный тип автомата `s21_fsm_t`, а также целочисленные
идентификаторы состояний и событий, используемые во всех вызовах API.

Эти типы задают «язык» описания модели автомата: набор возможных
состояний и событий, между которыми выполняются переходы.

@{
@typedef s21_fsm_t
@typedef s21_state_id_t
@typedef s21_event_id_t
@}
 */

 /**
@defgroup FSM_machine_lifecycle Жизненный цикл автомата
@ingroup FSM_machine
@brief Создание, уничтожение и инициализация FSM.

Функции этой подгруппы отвечают за полный жизненный цикл экземпляра
 автомата: выделение и освобождение ресурсов, первый запуск и повторный
 сброс к начальному состоянию.
 
 Без корректной инициализации (`initialize` или `reset`) автомат не
 готов к обработке событий и вызовы `dispatch`/`update` будут
 завершаться ошибками состояния.

 @{
 @fn s21_fsm_t *s21_fsm_create(void *user_ctx)
 @fn void s21_fsm_destroy(s21_fsm_t *fsm)
 @fn int s21_fsm_initialize(s21_fsm_t *fsm)
 @fn bool s21_fsm_is_initialized(const s21_fsm_t *fsm)
 @fn int s21_fsm_reset(s21_fsm_t *fsm)
 @}
 */

 /**
 @defgroup FSM_machine_control Управление автоматом
 @ingroup FSM_machine
 @brief Работа с состоянием автомата, событиями и контекстом.

 Здесь собраны функции «runtime‑управления» FSM: установка и чтение
 глобального контекста, выбор начального и отслеживание текущего
 состояния, а также обработка входящих событий и выполнение
 периодических действий.

 Эти вызовы используются в основном цикле программы, который
 взаимодействует с автоматом: читает события, передаёт их в `dispatch`
 и вызывает `update` для активного состояния.

 @{
    @fn int s21_fsm_set_context(s21_fsm_t *fsm, void *user_ctx)
    @fn void *s21_fsm_get_context(s21_fsm_t *fsm)
    @fn int s21_fsm_set_initial_state (s21_fsm_t *fsm, s21_state_id_t state_id)
    @fn s21_state_id_t s21_fsm_get_initial_state(const s21_fsm_t *fsm)
    @fn s21_state_id_t s21_fsm_get_current_state(const s21_fsm_t *fsm)
    @fn int s21_fsm_dispatch(s21_fsm_t *fsm, s21_event_id_t event)
    @fn int s21_fsm_update(s21_fsm_t *fsm)
 @}
 */