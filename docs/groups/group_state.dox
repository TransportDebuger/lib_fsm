/**
 * @defgroup FSM_state Состояние автомата
 * @brief Описание и управление состояниями FSM.
 *
 * Группа объединяет элементы API, отвечающие за работу с состояниями
 * автомата: идентификаторы состояний, их поведение (entry/do/exit),
 * регистрацию, обновление и удаление состояний.
 *
 * Через функции этой группы пользователь задаёт набор возможных
 * режимов работы автомата и то, что происходит при входе в состояние,
 * его активной фазе и выходе из него.
 */

/**
 * @defgroup FSM_state_types Типы, описывающие состояние
 * @ingroup FSM_state
 * @brief Базовые типы для идентификации и поведения состояния.
 *
 * Включает целочисленный идентификатор состояния и callback‑тип для
 * действий состояния (entry/do/exit).
 *
 * Идентификатор состояния (`s21_state_id_t`) должен быть неотрицательным
 * (>= 0) и уникальным внутри одного автомата; он используется для
 * регистрации, поиска и управления состоянием.
 *
 * Callback‑тип `s21_fsm_state_callback_t` задаёт действия, выполняемые
 * при входе в состояние, его активной работе и выходе.
 *
 * @{
 * @typedef s21_state_id_t
 * @typedef s21_fsm_state_callback_t
 * @}
 */

 /**
 * @defgroup FSM_state_ops Операции со состояниями
 * @ingroup FSM_state
 * @brief Регистрация, обновление и удаление состояний автомата.
 *
 * Эти функции позволяют описать модель состояний FSM: добавить новое
 * состояние с заданным поведением, изменить callbacks уже существующего
 * состояния или полностью удалить его из автомата.
 *
 * При регистрации состояние получает собственный идентификатор, набор
 * действий (entry/do/exit) и контекст, который будет передаваться во все
 * связанные callbacks.
 *
 * @{
 * @fn int s21_fsm_register_state(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id,
 *        s21_fsm_state_callback_t on_entry,
 *        s21_fsm_state_callback_t on_do,
 *        s21_fsm_state_callback_t on_exit,
 *        void *state_ctx)
 *
 * @fn int s21_fsm_update_state(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id,
 *        s21_fsm_state_callback_t on_entry,
 *        s21_fsm_state_callback_t on_do,
 *        s21_fsm_state_callback_t on_exit,
 *        void *state_ctx)
 *
 * @fn int s21_fsm_unregister_state(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id)
 * @}
 */

 /**
 * @defgroup FSM_state_context Контекст и роль состояния
 * @ingroup FSM_state
 * @brief Контекст состояния и выбор начального состояния.
 *
 * В этой подгруппе собраны функции, которые позволяют:
 * - назначать и извлекать контекст конкретного состояния;
 * - выбирать, какое состояние будет начальным для автомата.
 *
 * Контекст состояния (`state_ctx`) — это произвольный указатель,
 * ассоциированный с состоянием; он передается во все его callbacks
 * (`on_entry`, `on_do`, `on_exit`). Библиотека не управляет памятью
 * по этому указателю.
 *
 * Начальное состояние определяет точку входа автомата после вызова
 * `s21_fsm_initialize` или `s21_fsm_reset`.
 *
 * @{
 * @fn int s21_fsm_set_state_context(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id,
 *        void *state_ctx)
 *
 * @fn int s21_fsm_get_state_context(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id,
 *        void **out_state_ctx)
 *
 * @fn int s21_fsm_set_initial_state(
 *        s21_fsm_t *fsm,
 *        s21_state_id_t state_id)
 * @}
 */