/**
 * @defgroup FSM_status Ошибки. Коды возврата.
 * @brief Коды возврата и специальные значения для FSM.
 *
 * Группа объединяет все константы статуса, которые используются
 * функциями s21 FSM Library для сигнализации об успешном выполнении
 * операций и различных типах ошибок.
 *
 * Все публичные функции библиотеки, возвращающие `int`, используют
 * эти коды для однозначной интерпретации результата вызова:
 * `S21_FSM_OK` обозначает успех, отрицательные значения — разные
 * классы ошибок.
 *
 * Помимо кодов ошибок, сюда относится специальное значение
 * `S21_FSM_INVALID_STATE_ID`, обозначающее «невалидное» состояние.
 */

/**
 * @defgroup FSM_status_general Общие коды статуса
 * @ingroup FSM_status
 * @brief Базовые коды успешного выполнения и обобщённых ошибок.
 *
 * @{
 * @def S21_FSM_OK
 * @brief Успешное выполнение операции без ошибок.
 *
 * @def S21_FSM_ERROR
 * @brief Обобщённая ошибка выполнения операции.
 *
 * @def S21_FSM_NULL_POINTER
 * @brief Ошибка: передан нулевой указатель вместо ожидаемого объекта.
 *
 * @def S21_FSM_ALLOCATION_ERROR
 * @brief Ошибка: не удалось выделить или перераспределить память.
 * @}
 */

/**
 * @defgroup FSM_status_state Ошибки, связанные с состояниями
 * @ingroup FSM_status
 * @brief Коды ошибок для операций над состояниями.
 *
 * @{
 * @def S21_FSM_INVALID_STATE_ID
 * @brief Специальное значение «невалидного» идентификатора состояния.
 *
 * @def S21_FSM_STATE_NOT_FOUND
 * @brief Ошибка: состояние с указанным идентификатором не найдено.
 *
 * @def S21_FSM_STATE_INCORRECT_ID
 * @brief Ошибка: идентификатор состояния некорректен (отрицательное значение).
 *
 * @def S21_FSM_STATE_EXISTS
 * @brief Ошибка: состояние с таким идентификатором уже существует.
 * @}
 */

/**
 * @defgroup FSM_status_transition Ошибки, связанные с переходами и событиями
 * @ingroup FSM_status
 * @brief Коды ошибок для операций над переходами и обработкой событий.
 *
 * @{
 * @def S21_FSM_TRANSITION_NOT_FOUND
 * @brief Ошибка: указанный переход не найден.
 *
 * @def S21_FSM_NO_TRANSITION
 * @brief Ошибка: из текущего состояния нет подходящего перехода для события.
 *
 * @def S21_FSM_EVENT_INCORRECT_ID
 * @brief Ошибка: идентификатор события некорректен (отрицательное значение).
 * @}
 */

/**
 * @defgroup FSM_status_machine Ошибки состояния автомата
 * @ingroup FSM_status
 * @brief Коды ошибок, описывающие общий статус FSM.
 *
 * @{
 * @def S21_FSM_NOT_INITIALIZED
 * @brief Ошибка: автомат не инициализирован.
 *
 * @def S21_FSM_REENTRANT_CALL
 * @brief Ошибка: обнаружен реэнтрантный вызов FSM‑функции (dispatch/update).
 * @}
 */