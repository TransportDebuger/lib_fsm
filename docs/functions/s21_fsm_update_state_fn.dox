/**
 * @fn int s21_fsm_update_state(s21_fsm_t *fsm,
 *                              s21_state_id_t state_id,
 *                              s21_fsm_state_callback_t on_entry,
 *                              s21_fsm_state_callback_t on_do,
 *                              s21_fsm_state_callback_t on_exit,
 *                              void *state_ctx)
 *
 * @details
 * Функция позволяет изменить поведение уже зарегистрированного
 * состояния без его удаления и повторной регистрации.
 * Для состояния с идентификатором @p state_id переопределяются
 * три callback‑функции (`on_entry`, `on_do`, `on_exit`) и
 * пользовательский контекст @p state_ctx.
 *
 * Идентификатор @p state_id должен быть неотрицательным; при
 * передаче отрицательного значения функция возвращает
 * S21_FSM_STATE_INCORRECT_ID и не вносит изменений.
 *
 * Если @p fsm равен NULL, функция возвращает
 * S21_FSM_NULL_POINTER. Если состояние с указанным
 * идентификатором не найдено, возвращается
 * S21_FSM_STATE_NOT_FOUND, и FSM остаётся неизменной.
 *
 * @note Все callbacks и контекст являются опциональными: можно
 *       использовать эту функцию как для полного переопределения
 *       логики состояния, так и для частичного обновления (например,
 *       смены только @p state_ctx при неизменных callbacks).
 */